# Koneksi Postgres. Pilih salah satu:
# (a) Neon/Vercel: DATABASE_URL terisi otomatis oleh integrasi.
# (b) Supabase lewat integrasi Vercel (prefix TRYASE_): TRYASE_POSTGRES_URL (pooler 6543, dipakai aplikasi)
#     dan TRYASE_POSTGRES_URL_NON_POOLING (5432, dipakai migrasi) terisi otomatis. Tidak perlu diubah.
# (c) Manual: salin "Connection string" dari Supabase > Project Settings > Database.
DATABASE_URL=postgres://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Kunci anon/service_role Supabase TIDAK dipakai (aplikasi terhubung langsung ke Postgres dari server).

# Rahasia penandatangan sesi. Buat dengan: openssl rand -base64 32
AUTH_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# Kata sandi koordinator awal, berupa hash SHA-256 (hex) dari kata sandi.
# Buat dengan: printf 'KataSandiAnda' | shasum -a 256
# (Nilai di bawah = hash yang dipakai pada file HTML asli.)
COORDINATOR_PASSWORD_HASH=c7710401e92265fba17a348e183bc41c77579565b8e7532232c049054690d5e3

# Email koordinator yang boleh login/pemulihan lewat kode (pisahkan dengan koma).
COORDINATOR_EMAILS=koordinator@contoh.com

# Pengiriman email kode verifikasi (https://resend.com). Opsional; tanpa ini fitur kode email nonaktif.
RESEND_API_KEY=
EMAIL_FROM=TriaSiap <noreply@domain-anda.com>
